# 复制本文件为 .env 并填入你自己的值。
# .env 已被 .gitignore 忽略，不会上传/泄露；main.py 启动时会自动读取它。

# DeepSeek / OpenAI 兼容 LLM 的 API Key（AI 分析用）——填一次即可
LLM_API_KEY=在此填入你的Key
# 可选：换其他厂商时设置（默认走 DeepSeek）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 后端端口（同时决定前端 devProxy 目标；与已装原版的 10392 错开）
WECHAT_TOOL_PORT=10393

# 数据目录：复用已装原版解密好的数据（换成你自己的用户名）
WECHAT_TOOL_DATA_DIR=C:\Users\你的用户名\AppData\Roaming\wechat-data-analysis-desktop
