# Optional local overrides. The Agent/MCP workflow does not require this file.
# Copy it to `.env` only when you need to change a default. `.env` is ignored.

# Runtime paths. By default source runs use ./output and desktop builds use the
# app's per-user data directory.
# WECHAT_TOOL_DATA_DIR=C:\path\to\private\app-data
# WECHAT_TOOL_OUTPUT_DIR=C:\path\to\private\output

# Local web service settings. STDIO MCP does not use a port or bearer token.
# WECHAT_TOOL_HOST=127.0.0.1
# WECHAT_TOOL_PORT=10392

# Optional in-app third-party LLM. Never commit a real key. This is unrelated
# to Codex/Claude Code using the repository MCP server.
# LLM_API_KEY=replace-locally-only
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=model-name
